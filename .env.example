# Copy to .env and replace every "change-me" value.

# Pin a major version (e.g. 31) for predictable upgrades; "stable" follows the latest stable release.
NEXTCLOUD_VERSION=stable

# Name the reverse proxy serves Nextcloud on, over HTTPS. Set it before the first start.
# Leave empty to use Nextcloud directly on http://<server>:NEXTCLOUD_PORT without a proxy.
NEXTCLOUD_DOMAIN=nextcloud.home.yourdomain.nl

# Port the proxy forwards to (Forward Port in Nginx Proxy Manager).
NEXTCLOUD_PORT=8080
# 0.0.0.0 = reachable from the whole network. On Linux, 172.17.0.1 (Docker's
# bridge) lets only the proxy reach it, so nobody can skip HTTPS.
NEXTCLOUD_BIND_IP=0.0.0.0

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me
