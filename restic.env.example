# Copy to restic.env (install.sh does this and generates RESTIC_PASSWORD).
# Sourced by scripts/backup.sh and scripts/restore.sh, so keep values quoted.

# Hetzner Storage Box over SFTP on port 23. The path is relative to the box's home folder.
RESTIC_REPOSITORY="sftp://u123456@u123456.your-storagebox.de:23/nextcloud-restic"

# Encrypts the repository. Store it in your password manager: without it the backups are unreadable.
RESTIC_PASSWORD="change-me"

# Retention: how many daily, weekly and monthly snapshots to keep.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
